{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Reversi (API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Back/Reversi.Api/bin/Debug/net10.0/Reversi.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Back/Reversi.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5210"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}